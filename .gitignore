# Dependencies
# Never upload node_modules; it's too large and can be reinstalled via 'npm install'
node_modules/
.pnpm-store/
.turbo/

# Production Build Output
# These folders are generated during 'npm run build'
dist/
dist-ssr/
build/
out/

# Environment Variables (CRITICAL FOR SECURITY)
# Never upload your API keys or secret tokens
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow the template/example file so other developers know what keys are needed
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor/IDE Specific Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS Specific Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Additional Ignored Files
# Ignore temporary files and caches
*.tmp
*.temp
*.bak
*.swp
*.swo
*.DS_Store

# Ignore build artifacts
*.out
*.exe
*.dll
*.so
*.dylib
*.pyc
*.pyo
*.class
*.jar
*.war
*.ear

# Ignore test coverage reports
.nyc_output/
*.lcov
*.lcov.info

# Ignore documentation build artifacts
docs/_build/

# Ignore local scripts and binaries
scripts/*.sh
scripts/*.bat

# Ignore shared files
shared/*.tmp
shared/*.bak

# Ignore debug files
*.stackdump
*.core
*.trace

# Ignore miscellaneous files
*.iml
*.ipr
*.iws
*.swp
*.swo
*.bak
*.tmp
*.temp